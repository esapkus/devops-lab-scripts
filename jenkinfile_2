pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out code'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests'
                sh 'echo "Tests passed"'
            }
        }

        stage('Docker Check') {
            steps {
                sh 'docker --version'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed - check console logs'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
